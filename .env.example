# =============================================================================
# SpendWise Backend - Variables de entorno
# Copiar a .env y completar los valores
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# URL del frontend (para links en emails, ej. forgot-password)
APP_URL=http://localhost:4200
# Ruta de reset password en el frontend (opcional, default: /auth/reset-password)
# RESET_PASSWORD_PATH=/auth/reset-password

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# URL del pooler para runtime (conexiones serverless)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# URL directa para migraciones (Prisma requiere conexión directa)
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-use-long-random-string-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-different-from-jwt-secret
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_EXPIRES_IN=1h

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# API key desde https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Email remitente (debe estar verificado en Resend)
# Para pruebas: onboarding@resend.dev
# Producción: noreply@tudominio.com
RESEND_FROM=onboarding@resend.dev

# -----------------------------------------------------------------------------
# Redis/Queue (BullMQ)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
# CORS (orígenes permitidos, * para desarrollo)
CORS_ORIGIN=*

# LOG_LEVEL=debug
